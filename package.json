{
  "name": "heartsync",
  "private": true,
  "description": "HEART SYNC — src/·content/를 합쳐 index.html 한 파일로 빌드(의존성 없음)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "format": "node tools/format.mjs",
    "format:check": "node tools/format.mjs --check",
    "dev": "node tools/dev.mjs",
    "content:report": "node tools/content-report.mjs",
    "content:lock": "node tools/content-lock.mjs",
    "content:art": "node tools/content-art.mjs",
    "test": "node --test",
    "e2e": "node tests/run.mjs",
    "serve": "node tests/serve.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint-scope": "^8.4.0",
    "espree": "^10.4.0",
    "playwright": "^1.56.1",
    "prettier": "3.9.10"
  }
}
